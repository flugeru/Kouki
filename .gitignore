# build output
/dist/
Kouki.exe
*.exe.manifest.bak

# generated resources (rebuilt by tools/build.ps1 from kouki.ico + versioninfo.json)
# kouki.syso is intentionally NOT ignored so the icon/version metadata survives a
# plain `go build` without needing goversioninfo installed.
*.syso.tmp

# bundled MPV payload: ~127 MB of third-party binaries, regenerated by
#   .\tools\prepare-mpv.ps1 -Source "<seu mpv>"
# Keep the config files, ignore the heavy binaries.
assets/mpv/mpv.exe
assets/mpv/mpv.com
assets/mpv/d3dcompiler_43.dll
assets/mpv/portable_config/shaders/
assets/mpv/portable_config/cache/
assets/mpv/portable_config/watch_later/
assets/mpv/portable_config/scripts/uosc/bin/

# editor / OS noise
*.tmp
*.log
Thumbs.db
desktop.ini
.vscode/
.idea/
